---
import BrandLogo from './BrandLogo.astro';
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import aboutLocalSupport from '../assets/about/nimble-pay-local-support.png';
import cloverSystem from '../assets/equipment/clover-system.png';
import sumupSystem from '../assets/equipment/sumup-system.png';
import lavuMobile from '../assets/equipment/lavu-mobile.png';
import lavuCounter from '../assets/equipment/lavu-counter.png';
import heroEquipmentComposition from '../assets/equipment/hero-equipment-composition-transparent.png';
import cloverLogo from '../assets/partner-logos/clover.svg';
import lavuLogo from '../assets/partner-logos/lavu.webp';
import sumupLogo from '../assets/partner-logos/sumup.svg';
import dejavoLogo from '../assets/partner-logos/dejavoo.webp';
import shift4Logo from '../assets/partner-logos/shift4.svg';
import { siteCopy, type Locale } from '../content/site';

interface Props { locale: Locale }
const { locale } = Astro.props;
const c = siteCopy[locale];
const products = [cloverSystem, sumupSystem, lavuCounter, lavuMobile];
const partners = [{ name: 'Clover', image: cloverLogo }, { name: 'Lavu', image: lavuLogo }, { name: 'SumUp', image: sumupLogo }, { name: 'Dejavoo', image: dejavoLogo }, { name: 'Shift4', image: shift4Logo }];
const instagramPosts = ['DeCrgNqBNK0', 'Dd4W8T_PTSD', 'Ddox0uRhhsZ', 'DdeOV-khRWe', 'DdU8nh6zQ0K'];
---
<Layout title={c.title} description={c.description} lang={c.lang}>
  <header class="np-header"><div class="np-container np-nav"><a class="np-brand" href={c.path} aria-label="Nimble Pay"><BrandLogo /></a><nav aria-label="Main navigation"><a href="#solutions">{c.nav.solutions}</a><a href="#industries">{c.nav.industries}</a><a href="#hardware">{c.nav.hardware}</a><a href="#about">{c.nav.about}</a><a href="#support">{c.nav.support}</a></nav><div class="np-nav-actions"><a class="np-language" href={c.altPath} aria-label="Change language">{c.altLabel}</a><a class="np-button np-button-small" href="#demo">{c.demo}</a></div></div></header>

  <main>
    <section class="np-hero"><div class="np-hero-glow" aria-hidden="true"></div><div class="np-container np-hero-grid"><div class="np-hero-copy reveal"><p class="np-eyebrow">{c.hero.eyebrow}</p><h1>{c.hero.title}</h1><p class="np-lead">{c.hero.body}</p><div class="np-actions"><a class="np-button" href="#demo">{c.hero.primary}</a><a class="np-button np-button-ghost" href="tel:+12082841772">{c.hero.secondary} <span>→</span></a></div><div class="np-hero-proof"><span></span><p><strong>Meridian, Idaho</strong> · English & Español</p></div></div><div class="np-hero-media np-composite-hero reveal"><Image src={heroEquipmentComposition} format="webp" alt="Clover, SumUp and Lavu point of sale systems" /><div class="np-composite-caption"><span>{c.hero.note}</span><strong>{c.hero.noteStrong}</strong></div></div></div></section>

    <section class="np-partners" aria-label={c.trust}><div class="np-container"><p>{c.trust}</p><div class="np-partner-row">{partners.map((partner) => <img src={partner.image.src} alt={partner.name} loading="lazy" />)}</div></div></section>

    <section class="np-section np-reels" id="reels"><div class="np-container"><div class="np-reels-heading reveal"><div class="np-heading"><p class="np-eyebrow">{c.reels.eyebrow}</p><h2>{c.reels.title}</h2><p>{c.reels.body}</p></div><div class="np-reel-controls"><button type="button" aria-label={locale === 'es' ? 'Videos anteriores' : 'Previous videos'} data-reel-prev><span>←</span></button><button type="button" aria-label={locale === 'es' ? 'Videos siguientes' : 'Next videos'} data-reel-next><span>→</span></button></div></div><div class="np-reel-grid" data-reel-slider>{instagramPosts.map((post, index) => <article class="np-reel-card reveal" data-reel-card><div class="np-reel-media"><video src={`/media/reels/${post}-final.mp4`} poster={`/media/reels/${post}.jpg`} preload="metadata" playsinline aria-label={`${c.reels.item} ${index + 1}`} data-reel-video></video><button type="button" class="np-reel-play" aria-label={`${c.reels.play} ${index + 1}`} data-reel-play><span></span></button><div class="np-reel-mark"><b>NP</b><span>0{index + 1}</span></div></div><a href={`https://www.instagram.com/p/${post}/`} target="_blank" rel="noreferrer">{c.reels.open} <span>↗</span></a></article>)}</div></div></section>

    <section class="np-section" id="solutions"><div class="np-container"><div class="np-heading reveal"><p class="np-eyebrow">{c.payments.eyebrow}</p><h2>{c.payments.title}</h2><p>{c.payments.body}</p></div><div class="np-card-grid">{c.payments.items.map((item, index) => <article class="np-feature-card reveal"><span>0{index + 1}</span><h3>{item[0]}</h3><p>{item[1]}</p></article>)}</div></div></section>

    <section class="np-section np-soft" id="industries"><div class="np-container"><div class="np-heading reveal"><p class="np-eyebrow">{c.industries.eyebrow}</p><h2>{c.industries.title}</h2></div><div class="np-industry-grid">{c.industries.items.map((item, index) => <article class={`np-industry np-industry-${index + 1} reveal`}><div><p>0{index + 1}</p><h3>{item[0]}</h3><span>{item[1]}</span></div></article>)}</div></div></section>

    <section class="np-section np-dark" id="hardware"><div class="np-container"><div class="np-heading np-heading-light reveal"><p class="np-eyebrow">{c.hardware.eyebrow}</p><h2>{c.hardware.title}</h2><p>{c.hardware.body}</p></div><div class="np-equipment-grid">{c.hardware.products.map((item, index) => <article class={`np-equipment-card np-equipment-${index + 1} reveal`}><div class="np-equipment-image"><Image src={products[index]} format="webp" alt={item[0]} loading="lazy" /></div><div><span>0{index + 1}</span><h3>{item[0]}</h3><p>{item[1]}</p></div></article>)}</div><a class="np-text-link" href="#demo">{c.hardware.cta} <span>→</span></a></div></section>

    <section class="np-section"><div class="np-container np-split np-dual-pricing"><div class="reveal"><p class="np-eyebrow">{c.savings.eyebrow}</p><h2>{c.savings.title}</h2><p>{c.savings.body}</p><ol class="np-steps">{c.savings.points.map((point, index) => <li><span>0{index + 1}</span>{point}</li>)}</ol></div><div class="np-pricing-demo reveal" data-pricing-demo><div class="np-demo-screen"><div class="np-demo-top"><span>{c.savings.calculator.example}</span><strong>{c.savings.calculator.live}</strong></div><label>{c.savings.calculator.amount}<span><b>$</b><input data-price-input type="number" min="1" max="9999" step="0.01" value="20.00" inputmode="decimal" /></span></label><div class="np-method-toggle" role="group" aria-label={c.savings.calculator.method}><button type="button" data-method="card" class="active">{c.savings.calculator.card}</button><button type="button" data-method="cash">{c.savings.calculator.cash}</button></div><div class="np-receipt"><div><span>{c.savings.calculator.cardPrice}</span><strong data-card-price>$20.00</strong></div><div data-discount-row hidden><span>{c.savings.calculator.discount} <small>(4%)</small></span><strong data-discount>−$0.80</strong></div><div class="np-total"><span>{c.savings.calculator.total}</span><strong data-total>$20.00</strong></div></div><p data-demo-message>{c.savings.calculator.cardMessage}</p></div><div class="np-demo-hint">{c.savings.calculator.hint}</div></div></div></section>

    <section class="np-section np-about" id="about"><div class="np-container np-split"><div class="np-image-panel np-about-image reveal"><Image src={aboutLocalSupport} format="webp" alt={locale === 'es' ? 'Asesora de Nimble Pay ayudando al propietario de un restaurante con su sistema POS' : 'Nimble Pay advisor helping a restaurant owner with a POS system'} loading="lazy" /></div><div class="reveal"><p class="np-eyebrow">{c.about.eyebrow}</p><h2>{c.about.title}</h2><p>{c.about.body}</p><p>{c.about.body2}</p><div class="np-location"><strong>Meridian, Idaho</strong><span>Local support · Bilingual service</span></div></div></div></section>

    <section class="np-section np-testimonial"><div class="np-container"><div class="np-story-heading reveal"><div><p class="np-eyebrow">{c.testimonial.eyebrow}</p><span class="np-badge">{c.testimonial.badge}</span></div><div><h2>{c.testimonial.title}</h2><p>{c.testimonial.body}</p></div></div><div class="np-testimonial-grid">{c.testimonial.items.map((item, index) => <article class="np-testimonial-card reveal"><div class="np-story-number">0{index + 1}</div><div><span>{c.testimonial.pending}</span><h3>{item[0]}</h3><p>{item[1]}</p></div></article>)}</div></div></section>

    <section class="np-section np-dark" id="support"><div class="np-container np-support-grid"><div class="np-heading np-heading-light reveal"><p class="np-eyebrow">{c.support.eyebrow}</p><h2>{c.support.title}</h2><p>{c.support.body}</p></div><div class="np-support-list">{c.support.items.map((item, index) => <article class="reveal"><span>0{index + 1}</span><div><h3>{item[0]}</h3><p>{item[1]}</p></div></article>)}</div></div></section>

    <section class="np-section np-faq"><div class="np-container np-faq-grid"><div class="np-heading reveal"><p class="np-eyebrow">{c.faq.eyebrow}</p><h2>{c.faq.title}</h2></div><div>{c.faq.items.map((item, index) => <details class="reveal" open={index === 0}><summary>{item[0]}<span>+</span></summary><p>{item[1]}</p></details>)}</div></div></section>

    <section class="np-demo" id="demo"><div class="np-container np-demo-grid"><div class="reveal"><p class="np-eyebrow">{c.form.eyebrow}</p><h2>{c.form.title}</h2><p>{c.form.body}</p><a href="tel:+12082841772">(208) 284-1772</a><a href="mailto:opedraza@nimblepay.com">opedraza@nimblepay.com</a></div><form class="np-form reveal" data-demo-form data-locale={locale}><label>{c.form.name}<input name="name" required /></label><label>{c.form.business}<input name="business" required /></label><label>{c.form.email}<input name="email" type="email" required /></label><label>{c.form.phone}<input name="phone" type="tel" /></label><label class="np-form-wide">{c.form.type}<select name="type" required><option value="">—</option>{c.form.options.map((option) => <option>{option}</option>)}</select></label><label class="np-form-wide">{c.form.message}<textarea name="message" rows="4"></textarea></label><button class="np-button np-form-wide" type="submit">{c.form.submit}</button><small class="np-form-wide">{c.form.consent}</small></form></div></section>
  </main>

  <footer class="np-footer"><div class="np-container np-footer-grid"><div><BrandLogo footer /><p>{c.footer.tagline}</p></div><div><strong>{c.footer.explore}</strong><a href="#solutions">{c.nav.solutions}</a><a href="#industries">{c.nav.industries}</a><a href="#hardware">{c.nav.hardware}</a><a href="#about">{c.nav.about}</a></div><div><strong>{c.footer.contact}</strong><a href="tel:+12082841772">(208) 284-1772</a><a href="mailto:opedraza@nimblepay.com">opedraza@nimblepay.com</a><span>Meridian, Idaho</span></div></div><div class="np-container np-footer-bottom"><span>© {new Date().getFullYear()} Nimble Pay</span><div><a href={`/${locale}/privacy/`}>{c.footer.privacy}</a><a href={`/${locale}/terms/`}>{c.footer.terms}</a></div><p>{c.footer.disclaimer}</p></div></footer>

  <script define:vars={{ calculator: c.savings.calculator, locale }}>
    const observer = new IntersectionObserver((entries) => entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); } }), { threshold: .08 });
    document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));
    document.querySelectorAll('[data-demo-form]').forEach((form) => form.addEventListener('submit', (event) => {
      event.preventDefault();
      const data = new FormData(form);
      const isEnglish = form.dataset.locale === 'en';
      const subject = isEnglish ? 'Nimble Pay demo request' : 'Solicitud de demo Nimble Pay';
      const labels = isEnglish ? ['Name', 'Business', 'Email', 'Phone', 'Business type', 'Message'] : ['Nombre', 'Negocio', 'Correo', 'Teléfono', 'Tipo de negocio', 'Mensaje'];
      const keys = ['name', 'business', 'email', 'phone', 'type', 'message'];
      const body = keys.map((key, index) => `${labels[index]}: ${data.get(key) || '-'}`).join('\n');
      window.location.href = `mailto:opedraza@nimblepay.com?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
    }));
    document.querySelectorAll('[data-pricing-demo]').forEach((demo) => {
      const input = demo.querySelector('[data-price-input]');
      const buttons = demo.querySelectorAll('[data-method]');
      const cardPrice = demo.querySelector('[data-card-price]');
      const discount = demo.querySelector('[data-discount]');
      const discountRow = demo.querySelector('[data-discount-row]');
      const total = demo.querySelector('[data-total]');
      const message = demo.querySelector('[data-demo-message]');
      const copy = calculator;
      let method = 'card';
      const money = new Intl.NumberFormat(locale === 'es' ? 'es-US' : 'en-US', { style: 'currency', currency: 'USD' });
      const update = () => {
        const price = Math.max(0, Number(input.value) || 0);
        const saved = price * .04;
        cardPrice.textContent = money.format(price);
        discount.textContent = `−${money.format(saved)}`;
        discountRow.hidden = method !== 'cash';
        total.textContent = money.format(method === 'cash' ? price - saved : price);
        message.textContent = method === 'cash' ? copy.cashMessage : copy.cardMessage;
        buttons.forEach((button) => button.classList.toggle('active', button.dataset.method === method));
      };
      input.addEventListener('input', update);
      buttons.forEach((button) => button.addEventListener('click', () => { method = button.dataset.method; update(); }));
      update();
    });
    document.querySelectorAll('[data-reel-card]').forEach((card) => {
      const video = card.querySelector('[data-reel-video]');
      const play = card.querySelector('[data-reel-play]');
      const pauseOtherVideos = () => document.querySelectorAll('[data-reel-video]').forEach((other) => { if (other !== video) other.pause(); });
      const toggle = () => {
        if (video.paused) { pauseOtherVideos(); video.play(); }
        else video.pause();
      };
      play.addEventListener('click', toggle);
      video.addEventListener('click', toggle);
      video.addEventListener('play', () => card.classList.add('is-playing'));
      video.addEventListener('pause', () => card.classList.remove('is-playing'));
      video.addEventListener('ended', () => card.classList.remove('is-playing'));
    });
    document.querySelectorAll('[data-reel-slider]').forEach((slider) => {
      const section = slider.closest('.np-reels');
      const previous = section.querySelector('[data-reel-prev]');
      const next = section.querySelector('[data-reel-next]');
      const videos = [...slider.querySelectorAll('[data-reel-video]')];
      let autoplay;
      const step = () => {
        const card = slider.querySelector('[data-reel-card]');
        const gap = Number.parseFloat(getComputedStyle(slider).gap) || 0;
        return card.getBoundingClientRect().width + gap;
      };
      const updateControls = () => {
        const max = slider.scrollWidth - slider.clientWidth;
        previous.disabled = slider.scrollLeft <= 2;
        next.disabled = slider.scrollLeft >= max - 2;
      };
      const stopAutoplay = () => window.clearInterval(autoplay);
      const startAutoplay = () => {
        stopAutoplay();
        autoplay = window.setInterval(() => {
          if (document.hidden || videos.some((video) => !video.paused)) return;
          const max = slider.scrollWidth - slider.clientWidth;
          slider.scrollTo({ left: slider.scrollLeft >= max - 2 ? 0 : slider.scrollLeft + step(), behavior: 'smooth' });
        }, 5000);
      };
      const move = (direction) => {
        slider.scrollBy({ left: direction * step(), behavior: 'smooth' });
        startAutoplay();
      };
      previous.addEventListener('click', () => move(-1));
      next.addEventListener('click', () => move(1));
      videos.forEach((video) => {
        video.addEventListener('play', stopAutoplay);
        video.addEventListener('pause', () => { if (!videos.some((item) => !item.paused)) startAutoplay(); });
        video.addEventListener('ended', () => { if (!videos.some((item) => !item.paused)) startAutoplay(); });
      });
      slider.addEventListener('scroll', updateControls, { passive: true });
      window.addEventListener('resize', updateControls);
      updateControls();
      startAutoplay();
    });
  </script>
</Layout>
