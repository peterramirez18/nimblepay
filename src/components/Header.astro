---
import BrandLogo from './BrandLogo.astro';
import Button from './Button.astro';
---
<header class="site-header wrap">
	<a class="brand" href="#top" aria-label="Nimble Pay, inicio"><BrandLogo /></a>
	<nav aria-label="Navegación principal"><a href="#soluciones">Soluciones</a><a href="#beneficios">Beneficios</a><a href="#soporte">Soporte</a></nav>
	<div class="header-actions">
		<button class="theme-toggle" type="button" aria-label="Cambiar tema" aria-pressed="false">
			<svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3.5"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
			<svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 15.4A8.4 8.4 0 0 1 8.6 4a8.5 8.5 0 1 0 11.4 11.4Z"/></svg>
		</button>
		<Button href="#contacto" compact>Agendar demo</Button>
	</div>
</header>
