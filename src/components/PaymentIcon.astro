---
interface Props { name: 'card' | 'contactless' | 'wallet'; }
const { name } = Astro.props;
---
<div class:list={['payment-icon', name]} aria-hidden="true">
	{name === 'card' && <svg viewBox="0 0 32 32"><rect x="3" y="7" width="26" height="18" rx="3"/><path d="M3 12h26M8 19h7"/></svg>}
	{name === 'contactless' && <svg viewBox="0 0 32 32"><path d="M10 11a7 7 0 0 1 0 10M15 7a12 12 0 0 1 0 18M20 3a17 17 0 0 1 0 26"/></svg>}
	{name === 'wallet' && <svg viewBox="0 0 32 32"><path d="M5 8h20a3 3 0 0 1 3 3v15H7a4 4 0 0 1-4-4V9a4 4 0 0 1 4-4h16"/><path d="M21 14h8v7h-8a3.5 3.5 0 0 1 0-7Z"/></svg>}
</div>
