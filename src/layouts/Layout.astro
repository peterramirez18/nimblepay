---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
interface Props { title?: string; description?: string; lang?: string; }
const { title = 'Nimble Pay', description = 'Pagos inteligentes para tu negocio.', lang = 'es' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="description" content={description} /><meta name="theme-color" content="#071647" />
		<meta name="generator" content={Astro.generator} /><meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><title>{title}</title>
		<ClientRouter fallback="swap" />
	</head>
	<body><slot /></body>
</html>
