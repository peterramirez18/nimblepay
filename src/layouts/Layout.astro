---
import '../styles/global.css';
interface Props { title?: string; description?: string; }
const { title = 'Nimble Pay', description = 'Pagos inteligentes para tu negocio.' } = Astro.props;
---
<!doctype html>
<html lang="es" data-theme="dark">
	<head>
		<meta charset="UTF-8" /><meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" /><link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description} /><meta name="theme-color" content="#080626" />
		<meta name="generator" content={Astro.generator} /><title>{title}</title>
		<script is:inline>try{const t=localStorage.getItem('nimble-theme');if(t)document.documentElement.dataset.theme=t}catch{}</script>
	</head>
	<body><slot /></body>
</html>
